# Onyx Discord Bot Environment Configuration
# Replace with your actual credentials

# Your Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Your Discord Application / Client ID
CLIENT_ID=YOUR_CLIENT_ID_HERE

# (Optional) Test Guild ID for instant slash command registration during development
# Leave empty to register commands globally across all servers
GUILD_ID=

# Default Command Prefix (fallback if not configured per-guild)
DEFAULT_PREFIX=!

# Bot Owner Discord IDs (comma-separated if multiple)
OWNER_IDS=

