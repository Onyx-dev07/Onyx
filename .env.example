# Copy this file to .env and replace placeholder values.

# =========================
# DISCORD
# =========================
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
# Optional: test server ID (slash commands register globally by default).
GUILD_ID=
# Comma-separated bot owner IDs (owner-only commands).
OWNER_IDS=

# =========================
# BOT RUNTIME
# =========================
NODE_ENV=production
LOG_LEVEL=warn
LOG_TO_FILE=false
SENTRY_DSN=

# Command prefix for text commands.
PREFIX=!
# Legacy alias kept for compatibility.
DEFAULT_PREFIX=!

# =========================
# WEB / API
# =========================
PORT=3000
WEB_HOST=0.0.0.0
PORT_RETRY_ATTEMPTS=5
CORS_ORIGIN=*

# =========================
# DATABASE
# =========================
# Onyx stores all data in data/database.json by default. No PostgreSQL required.
# Set USE_POSTGRES=true only if you want the optional PostgreSQL backend.
USE_POSTGRES=false
POSTGRES_URL=
POSTGRES_SSL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=onyxbot
POSTGRES_USER=
POSTGRES_PASSWORD=
# Optional PostgreSQL migration controls (only used when USE_POSTGRES=true).
AUTO_MIGRATE=true
SCHEMA_VERSION=1
SCHEMA_VERSION_LABEL=baseline-v1

# =========================
# OPTIONAL FEATURE/API KEYS
# =========================
TMDB_API_KEY=
