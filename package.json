{
  "name": "onyx-bot",
  "version": "4.0.0",
  "description": "Onyx - a modular Discord bot for invite tracking, giveaways, moderation, and server automation.",
  "main": "src/bot.js",
  "type": "module",
  "scripts": {
    "start": "node src/bot.js",
    "format": "prettier --write \"src/**/*.js\"",
    "migrate": "node scripts/migrate.js apply",
    "migrate:check": "node scripts/migrate.js check",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:keys": "node scripts/migrate.js keys",
    "migrate:keys:dry": "node scripts/migrate.js keys",
    "backup:db": "node scripts/migrate.js backup:db",
    "restore:db": "node scripts/migrate.js restore:db",
    "backup:drill": "node scripts/migrate.js backup:drill"
  },
  "imports": {
    "#commands/*": "./src/commands/*.js",
    "#command": "./src/structures/classes/command.js",
    "#context": "./src/structures/classes/context.js",
    "#config": "./src/config/config.js",
    "#emoji": "./src/config/emoji.js",
    "#dbManager": "./src/database/manager.js",
    "#structures/*": "./src/structures/*.js",
    "#database/*": "./src/database/*.js",
    "#config/*": "./src/config/*.js",
    "#utils": "./src/utils/index.js",
    "#utils/integrity": "./src/utils/integrity.js",
    "#timerUtils": "./src/utils/timerUtils.js",
    "#giveawayUtils": "./src/utils/giveawayUtils.js",
    "#events/*": "./src/events/*.js",
    "#handlers/*": "./src/structures/handlers/*.js",
    "#classes/*": "./src/structures/classes/*.js",
    "#db/*": "./src/database/*.js",
    "#dbRepo/*": "./src/database/repositories/*.js",
    "#dbServices/*": "./src/database/services/*.js",
    "#src/*": "./src/*.js"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "onyx",
    "modular",
    "invite-tracker",
    "giveaway"
  ],
  "author": "Onyx",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Onyx-dev07/Onyx",
  "bugs": {
    "url": "https://discord.gg/QnWNz2dKCE"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "discord-api-types": "^0.38.48",
    "discord.js": "^14.25.1",
    "dokdo": "^1.0.1",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "mongoose": "^9.3.3",
    "prettier": "^3.8.1"
  }
}
