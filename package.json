{
  "name": "onyx-bot",
  "version": "5.0.0",
  "description": "Onyx - a modular Discord bot for moderation, security, automation, and server utilities.",
  "main": "src/client.js",
  "scripts": {
    "start": "node src/client.js",
    "sync:emojis": "node scripts/syncEmojis.js",
    "format": "prettier --write \"src/**/*.js\"",
    "migrate": "node scripts/migrate.js apply",
    "migrate:check": "node scripts/migrate.js check",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:keys": "node scripts/migrate.js keys",
    "migrate:keys:dry": "node scripts/migrate.js keys",
    "backup:db": "node scripts/migrate.js backup:db",
    "restore:db": "node scripts/migrate.js restore:db",
    "backup:drill": "node scripts/migrate.js backup:drill"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js",
    "onyx",
    "moderation",
    "security",
    "automation"
  ],
  "author": "Onyx",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Onyx-dev07/Onyx",
  "bugs": {
    "url": "https://discord.gg/QnWNz2dKCE"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "axios": "^1.11.0",
    "bytez.js": "^3.0.0",
    "discord.js": "^14.25.1",
    "dokdo": "1.0.1",
    "dotenv": "^17.2.3",
    "ms": "^2.1.3",
    "pg": "^8.20.0",
    "prettier": "^3.8.1",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.37.7",
    "serpapi": "^2.2.1",
    "uuid": "^9.0.1",
    "wikipedia": "^2.4.2",
    "youtube-search-api": "^2.0.1"
  }
}
